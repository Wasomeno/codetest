# ────────────────────────────────────────────────────────────────────
#  codetest frontend — environment variables
# ────────────────────────────────────────────────────────────────────
#
#  Copy this file to `.env.local` and edit. Vite reads `.env.local`
#  automatically; it is git-ignored by default.
#
#  Both variables are read at dev/build time. Restart `bun --bun
#  vite dev` after changing them.
#
# ────────────────────────────────────────────────────────────────────
#  VITE_API_BASE_URL — the URL the frontend fetches.
# ────────────────────────────────────────────────────────────────────
#
#  This is the canonical way to point the frontend at any backend,
#  whether local or deployed. Trailing slashes are stripped.
#
#  Examples:
#    VITE_API_BASE_URL=/api                        # same-origin /api (default; works when reverse-proxied)
#    VITE_API_BASE_URL=http://localhost:3000       # local qa-extension-backend on its default port
#    VITE_API_BASE_URL=https://staging-api.acme.com
#    VITE_API_BASE_URL=https://api.acme.com/api/v1
#
#  If unset, the frontend uses the same-origin `/api` path. In dev that
#  path is intercepted by the Vite proxy (see VITE_API_PROXY_TARGET
#  below); in production it expects a reverse proxy in front of the
#  frontend.
VITE_API_BASE_URL=

# ────────────────────────────────────────────────────────────────────
#  VITE_API_PROXY_TARGET — dev-only: where Vite forwards /api/* to.
# ────────────────────────────────────────────────────────────────────
#
#  Read by `vite.config.ts` ONLY. Has no effect on production builds.
#  In production, set VITE_API_BASE_URL instead and deploy behind a
#  reverse proxy, or point VITE_API_BASE_URL directly at the backend.
#
#  Default: http://localhost:4000 (qa-extension-backend's documented
#  default; the actual default in this repo's `main.go` is :3000,
#  so most people override it).
#
#  Examples:
#    VITE_API_PROXY_TARGET=http://localhost:3000       # qa-extension-backend on :3000
#    VITE_API_PROXY_TARGET=http://localhost:4000       # default
#    VITE_API_PROXY_TARGET=https://staging-api.acme.com
VITE_API_PROXY_TARGET=http://localhost:3000
